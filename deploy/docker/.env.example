# Copy to .env next to docker-compose.yml and edit before bringing the stack up.
POSTGRES_PASSWORD=change-me
# The address agents will use to reach this server.
PUBLIC_URL=https://mdm.example.com
# Public keys (comma-separated) that sign agent builds. From: retune-sign keygen
AGENT_RELEASE_KEYS=
# Optional: operations keys scripts and wipes are signed with, when agents are
# built to require them (OPERATIONS_PUBKEYS). The server checks early.
# OPERATIONS_KEYS=
# Optional: hold wipes, and code sent to more than APPROVAL_DEVICE_THRESHOLD
# devices, until a second administrator approves them.
# APPROVALS_REQUIRED=false
# APPROVAL_DEVICE_THRESHOLD=50

# Optional: the relay alert email goes through.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=retune@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optional: turns on /metrics. At least 32 characters, e.g. from: openssl rand -hex 32
# METRICS_TOKEN=

# How many days of history to keep. 0 keeps it forever. Raise these before
# upgrading if you need more than the defaults: the first run deletes the rest.
# AUDIT_RETENTION_DAYS=365
# COMMAND_RETENTION_DAYS=90
# SCRIPT_RUN_RETENTION_DAYS=90
# APP_INSTALL_RETENTION_DAYS=90

# Optional: copy the audit log to a SIEM, over syslog (udp://, tcp:// or
# tls://host:port) and/or as JSON posted to an HTTPS URL.
# AUDIT_SYSLOG_ADDRESS=tls://siem.example.com:6514
# AUDIT_WEBHOOK_URL=https://siem.example.com/ingest
# AUDIT_WEBHOOK_HEADER=Authorization: Bearer <token>

# Optional: single sign-on. Register <PUBLIC_URL>/api/admin/v1/oidc/callback
# as the redirect URL with the provider.
# OIDC_ISSUER=https://login.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ADMIN_GROUPS=
# OIDC_HELPDESK_GROUPS=
# OIDC_READONLY_GROUPS=
# Optional: devices each group may manage, and the groups that manage all of them.
# OIDC_SCOPE_GROUPS=helpdesk-emea=EMEA laptops;helpdesk-us=US laptops
# OIDC_FLEET_GROUPS=it-admins

# Optional: updating the server from the console. Start the updater with
#   docker compose --profile updater up -d
# UPDATER_TOKEN is shared by the server and the updater: at least 16
# characters, e.g. from: openssl rand -hex 32. The updater also needs
# AGENT_RELEASE_KEYS above, to verify releases itself.
# UPDATER_TOKEN=
# How many database dumps (taken before each update) to keep.
# UPDATER_BACKUPS_KEEP=5
# The server image. The updater pins this to a release's digest; set it to a
# tag of your own to run a build from source (docker compose build server).
# RETUNE_IMAGE=ghcr.io/ssan9876/retune-server:latest
