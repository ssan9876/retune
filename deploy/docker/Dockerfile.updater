# syntax=docker/dockerfile:1

# The retune-updater: the one container in the stack with the Docker socket.
# It is built on the Docker CLI image because it drives Docker Compose - it
# pins the new server image in the project's .env and has Compose recreate
# the server, so the project stays the record of what runs. Keeping it out of
# the server's image keeps the socket and a shell out of the internet-facing
# container.

FROM --platform=$BUILDPLATFORM golang:1.27 AS build
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=0.0.0-dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags "-X retune/internal/version.Version=$VERSION" -o /out/retune-updater ./cmd/retune-updater

FROM docker:27-cli
ARG VERSION=0.0.0-dev
LABEL org.opencontainers.image.version=$VERSION \
      org.opencontainers.image.title="retune-updater"
COPY --from=build /out/retune-updater /usr/local/bin/retune-updater
ENTRYPOINT ["/usr/local/bin/retune-updater"]
